{
  "rewrites": [
    { "source": "/peta", "destination": "/peta.html" },
    { "source": "/detail", "destination": "/detail.html" },
    { "source": "/lapor", "destination": "/lapor.html" },
    { "source": "/lacak", "destination": "/lacak.html" },
    { "source": "/skor", "destination": "/skor.html" },
    { "source": "/jejak", "destination": "/jejak.html" },
    { "source": "/petugas", "destination": "/petugas.html" },
    { "source": "/tentang", "destination": "/tentang.html" },
    { "source": "/panduan", "destination": "/panduan.html" },
    { "source": "/desain", "destination": "/desain.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
